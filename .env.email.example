# ====================================
# CONFIGURAÇÕES DE EMAIL
# ====================================

# SMTP (Mailpit local por padrao)
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# Interface web para visualizar emails em dev/test
EMAIL_HTTP_HOST=localhost
EMAIL_HTTP_PORT=8025

# URL base da aplicação (para links nos emails)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ====================================
# INSTRUÇÕES DE CONFIGURAÇÃO
# ====================================

# Para o Gmail:
# 1. Acesse sua conta do Google
# 2. Vá em "Gerenciar sua conta do Google"
# 3. Na aba "Segurança", ative a "Verificação em duas etapas"
# 4. Ainda na aba "Segurança", vá em "Senhas de app"
# 5. Selecione "Email" e "Outro (nome personalizado)"
# 6. Digite "Espaço Dialógico" ou nome da sua aplicação
# 7. Use a senha gerada no EMAIL_SMTP_PASSWORD (sem espaços)

# Para outros provedores:
# Consulte a documentação do Nodemailer para configurações específicas
# https://nodemailer.com/smtp/

# Exemplo para Outlook/Hotmail:
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=seu-email@gmail.com
# EMAIL_SMTP_PASSWORD=sua-senha-de-app

# Exemplo para provedor personalizado:
# EMAIL_SMTP_HOST=smtp.seudominio.com
# EMAIL_SMTP_PORT=587
